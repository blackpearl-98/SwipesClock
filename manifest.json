{
  "manifest_version": 3,
  "name": "SwipeClock — greytHR Swipes Time Tracker",
  "version": "1.2.1",
  "author": "BMR",
  "description": "Live work hours, break duration, and ideal leaving time tracker for greytHR daily swipes.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.greythr.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SwipeClock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greythr.com/*"
      ],
      "js": [
        "network-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.greythr.com/*"
      ],
      "js": [
        "calculator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
